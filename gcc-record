#!/bin/sh
# gcc-record: drop-in replacement for gcc that loads the gcc-record plugins.
#
#   -z   write gzip-compressed records (*.gcc-record.gz)
#   -Z   write zstd-compressed records (*.gcc-record.zst)
#
# All other arguments are passed to gcc unchanged.  gcc's own "-z KEYWORD"
# linker option (e.g. "-z now", "-z relro") is recognized and passed through.
#
# Environment:
#   GCC_RECORD_CC          compiler to run (default: gcc)
#   GCC_RECORD_PLUGIN_DIR  directory holding the plugins (default: script dir)

cc=${GCC_RECORD_CC:-gcc}
dir=${GCC_RECORD_PLUGIN_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
cc_plugin=$dir/gcc_record.so
ld_plugin=$dir/gcc-record-ld.so

for p in "$cc_plugin" "$ld_plugin"; do
  if [ ! -f "$p" ]; then
    echo "gcc-record: plugin not found: $p" >&2
    exit 1
  fi
done

mode=
first=1
for arg in "$@"; do
  if [ -n "$first" ]; then
    set --
    first=
  fi
  if [ -n "$pending_z" ]; then
    pending_z=
    case $arg in
      -* | */* | *.*)
	# Not a linker keyword: the preceding -z was ours.
	mode=z ;;
      *)
	set -- "$@" -z "$arg"
	continue ;;
    esac
  fi
  case $arg in
    -z) pending_z=1 ;;
    -Z) mode=Z ;;
    *) set -- "$@" "$arg" ;;
  esac
done
[ -n "$pending_z" ] && mode=z

cc_opts="-fplugin=$cc_plugin"
ld_opts="-Wl,-plugin=$ld_plugin"
if [ -n "$mode" ]; then
  cc_opts="$cc_opts -fplugin-arg-gcc_record-$mode"
  ld_opts="$ld_opts,-plugin-opt=-$mode"
fi

# shellcheck disable=SC2086
exec "$cc" $cc_opts $ld_opts "$@"
