#!/bin/sh
# gcc-record: drop-in replacement for gcc that loads the gcc-record plugins.
#
#   --record=gz     write gzip-compressed records (*.gcc-record.gz)
#   --record=zstd   write zstd-compressed records (*.gcc-record.zst)
#
# All other arguments (including -z/-Z) are passed to gcc unchanged.
#
# Environment:
#   GCC_RECORD_CC          compiler to run (default: gcc)
#   GCC_RECORD_PLUGIN_DIR  directory holding the plugins (default: script dir)

cc=${GCC_RECORD_CC:-gcc}
dir=${GCC_RECORD_PLUGIN_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
cc_plugin=$dir/gcc_record.so
ld_plugin=$dir/gcc-record-ld.so

for p in "$cc_plugin" "$ld_plugin"; do
  if [ ! -f "$p" ]; then
    echo "gcc-record: plugin not found: $p" >&2
    exit 1
  fi
done

mode=
first=1
for arg in "$@"; do
  if [ -n "$first" ]; then
    set --
    first=
  fi
  case $arg in
    --record=gz) mode=z ;;
    --record=zstd) mode=Z ;;
    --record=*)
      echo "gcc-record: unknown compression '${arg#--record=}' (use gz or zstd)" >&2
      exit 1 ;;
    *) set -- "$@" "$arg" ;;
  esac
done

cc_opts="-fplugin=$cc_plugin"
ld_opts="-Wl,-plugin=$ld_plugin"
if [ -n "$mode" ]; then
  cc_opts="$cc_opts -fplugin-arg-gcc_record-$mode"
  ld_opts="$ld_opts,-plugin-opt=-$mode"
fi

# shellcheck disable=SC2086
exec "$cc" $cc_opts $ld_opts "$@"
